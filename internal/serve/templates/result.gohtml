{{define "content" -}}
<h1 class="mb-4 text-2xl font-bold">{{.KindTitle}}</h1>
{{if .Failed}}
<p role="alert" class="mb-4 rounded border border-red-300 bg-red-50 px-3 py-2 text-sm text-red-800">{{.Message}}</p>
{{with .Details}}
<section aria-label="Failure details" class="mb-6">
<h2 class="mb-2 text-lg font-semibold">Details</h2>
<pre class="overflow-x-auto rounded border border-gray-200 bg-white p-3 text-xs">{{.}}</pre>
</section>
{{end}}
{{else if .Notice}}
<p role="status" class="mb-4 rounded border border-amber-300 bg-amber-50 px-3 py-2 text-sm text-amber-800">{{.Notice}}</p>
{{else}}
{{if .Partial}}
<p role="status" class="mb-4 rounded border border-amber-300 bg-amber-50 px-3 py-2 text-sm text-amber-800">Done, with failures - see below.</p>
{{else}}
<p role="status" class="mb-4 rounded border border-green-300 bg-green-50 px-3 py-2 text-sm text-green-800">Done.</p>
{{end}}
{{if .Facts}}
<section aria-label="Result" class="mb-6">
<h2 class="mb-2 text-lg font-semibold">Result</h2>
<dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
{{range .Facts}}<dt class="font-medium text-gray-500">{{.Label}}</dt><dd>{{.Value}}</dd>{{end}}
</dl>
</section>
{{end}}
{{end}}
<p class="mt-4 flex flex-wrap gap-4">
<a class="underline" href="/mods">Back to mods</a>
<a class="underline" href="/">Dashboard</a>
</p>
{{- end}}
