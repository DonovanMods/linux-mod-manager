{{define "content" -}}
<h1 class="mb-4 text-2xl font-bold">Health</h1>
{{if not .Verify}}
{{if not .Nav.Games}}
<p class="text-gray-600">No games configured.</p>
<p class="mt-2 text-sm text-gray-600">Add one from the command line with <code>lmm game add</code>.</p>
{{else}}
<p class="text-gray-600">Select a game and profile above to check its health.</p>
{{end}}
{{else}}

<section aria-label="Verify findings" class="mb-6">
<h2 class="mb-2 text-lg font-semibold">Verify findings</h2>
{{if not .Verify.Result.HasFiles}}
<p class="text-sm text-gray-600">No files found for this profile - nothing to verify yet.</p>
{{else if not .Verify.Result.Findings}}
<p class="text-sm text-gray-600">No issues found ({{.Verify.Result.Checked}} file(s) checked).</p>
{{else}}
<p class="mb-2 text-sm text-gray-600">{{.Verify.Result.Issues}} issue(s), {{.Verify.Result.Warnings}} warning(s), {{.Verify.Result.Checked}} file(s) checked.</p>
<!-- Renders every finding unbounded for v2.1.0 - no pagination. -->
<div class="overflow-x-auto">
<table class="w-full text-left text-sm">
<thead>
<tr class="border-b border-gray-200 text-gray-500">
<th scope="col" class="py-2 pr-4">Mod</th>
<th scope="col" class="py-2 pr-4">File</th>
<th scope="col" class="py-2 pr-4">Status</th>
<th scope="col" class="py-2 pr-4">Note</th>
</tr>
</thead>
<tbody>
{{range .Verify.Result.Findings}}
<tr class="border-b border-gray-100">
<td class="py-2 pr-4">{{.ModName}}</td>
<td class="py-2 pr-4">{{.FileID}}</td>
<td class="py-2 pr-4">{{.Status}}</td>
<td class="py-2 pr-4">{{.Note}}</td>
</tr>
{{end}}
</tbody>
</table>
</div>
{{end}}
<form method="post" action="/health/fix">
<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
<input type="hidden" name="game" value="{{.Nav.Game.ID}}">
<input type="hidden" name="profile" value="{{.Nav.Profile}}">
<button type="submit" disabled class="mt-3 rounded border border-gray-300 px-3 py-1 text-sm text-gray-400">Fix issues</button>
<p class="mt-1 text-xs text-gray-400">Mutations are coming in this release.</p>
</form>
</section>

<section aria-label="File conflicts">
<h2 class="mb-2 text-lg font-semibold">Conflicts</h2>
{{if not .Conflicts}}
<p class="text-sm text-gray-600">No file conflicts between enabled mods.</p>
{{else}}
<!-- Renders every conflict unbounded for v2.1.0 - no pagination. -->
<div class="overflow-x-auto">
<table class="w-full text-left text-sm">
<thead>
<tr class="border-b border-gray-200 text-gray-500">
<th scope="col" class="py-2 pr-4">Path</th>
<th scope="col" class="py-2 pr-4">Owner</th>
<th scope="col" class="py-2 pr-4">Also provided by</th>
<th scope="col" class="py-2 pr-4">Stale</th>
</tr>
</thead>
<tbody>
{{range .Conflicts}}
<tr class="border-b border-gray-100">
<td class="py-2 pr-4">{{.Path}}</td>
<td class="py-2 pr-4">{{.Owner.Name}}</td>
<td class="py-2 pr-4">{{range $i, $m := .AlsoIn}}{{if $i}}, {{end}}{{$m.Name}}{{end}}</td>
<td class="py-2 pr-4">{{if .Stale}}yes{{else}}no{{end}}</td>
</tr>
{{end}}
</tbody>
</table>
</div>
{{end}}
</section>
{{end}}
{{- end}}
