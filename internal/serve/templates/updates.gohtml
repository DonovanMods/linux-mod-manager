{{define "content" -}}
<h1 class="mb-4 text-2xl font-bold">Updates</h1>
{{if not .Nav.Game}}
{{if not .Nav.Games}}
<p class="text-gray-600">No games configured.</p>
<p class="mt-2 text-sm text-gray-600">Add one from the command line with <code>lmm game add</code>.</p>
{{else}}
<p class="text-gray-600">Select a game and profile above to check for updates.</p>
{{end}}
{{else if not .Updates}}
<p class="text-gray-600">No updates available.</p>
{{else}}
<form method="post" action="/updates/apply">
<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
<input type="hidden" name="game" value="{{.Nav.Game.ID}}">
<input type="hidden" name="profile" value="{{.Nav.Profile}}">
<!-- Renders every available update unbounded for v2.1.0 - no pagination. -->
<div class="overflow-x-auto">
<table class="w-full text-left text-sm">
<thead>
<tr class="border-b border-gray-200 text-gray-500">
<th scope="col" class="py-2 pr-4"><span class="sr-only">Select</span></th>
<th scope="col" class="py-2 pr-4">Name</th>
<th scope="col" class="py-2 pr-4">Current</th>
<th scope="col" class="py-2 pr-4">New</th>
<th scope="col" class="py-2 pr-4">Locked</th>
</tr>
</thead>
<tbody>
{{range .Updates}}
<tr class="border-b border-gray-100">
<td class="py-2 pr-4">
<input type="checkbox" disabled name="mod" value="{{.InstalledMod.SourceID}}:{{.InstalledMod.ID}}" aria-label="Select {{.InstalledMod.Name}} for update">
</td>
<td class="py-2 pr-4"><a class="font-medium text-blue-700 hover:underline" href="/mods/{{.InstalledMod.SourceID}}/{{.InstalledMod.ID}}">{{.InstalledMod.Name}}</a></td>
<td class="py-2 pr-4">{{.InstalledMod.Version}}</td>
<td class="py-2 pr-4">{{if .RecompileNeeded}}recompile ({{.RecompileReason}}){{else}}{{.NewVersion}}{{end}}</td>
<td class="py-2 pr-4">{{if .Locked}}yes ({{.LockedVersion}}){{else}}no{{end}}</td>
</tr>
{{end}}
</tbody>
</table>
</div>
<button type="submit" disabled class="mt-3 rounded border border-gray-300 px-3 py-1 text-sm text-gray-400">Apply selected</button>
<p class="mt-1 text-xs text-gray-400">Mutations are coming in this release.</p>
</form>
{{end}}
{{- end}}
