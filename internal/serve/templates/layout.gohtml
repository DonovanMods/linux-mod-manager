{{define "layout" -}}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}} - lmm</title>
<link rel="stylesheet" href="/static/app.css">
</head>
<body class="min-h-screen bg-gray-50 text-gray-900">
<header class="border-b border-gray-200 bg-white">
<nav class="mx-auto flex max-w-3xl flex-wrap items-center gap-4 p-4" aria-label="Primary">
<a class="text-lg font-bold" href="/">lmm</a>
{{with .Nav}}
<div class="flex flex-wrap items-center gap-3 text-sm text-gray-700">
{{if .Game}}<span>{{.Game.Name}} / {{if .Profile}}{{.Profile}}{{else}}<em>no active profile</em>{{end}}</span>{{end}}
{{if or (gt (len .Games) 1) (gt (len .Profiles) 1)}}
<form method="get" action="{{$.Path}}" class="flex flex-wrap items-center gap-2" aria-label="Switch game or profile">
{{range $.ExtraParams}}<input type="hidden" name="{{.Key}}" value="{{.Value}}">{{end}}
{{$cur := .Game}}
{{if gt (len .Games) 1}}
<label class="sr-only" for="nav-game">Game</label>
<select id="nav-game" name="game" class="rounded border-gray-300 text-sm">
{{range .Games}}<option value="{{.ID}}"{{if and $cur (eq .ID $cur.ID)}} selected{{end}}>{{.Name}}</option>{{end}}
</select>
{{end}}
{{if gt (len .Profiles) 1}}
<label class="sr-only" for="nav-profile">Profile</label>
<select id="nav-profile" name="profile" class="rounded border-gray-300 text-sm">
{{$curProfile := .Profile}}
{{range .Profiles}}<option value="{{.}}"{{if eq . $curProfile}} selected{{end}}>{{.}}</option>{{end}}
</select>
{{end}}
<button type="submit" class="rounded border border-gray-300 px-2 py-1 text-xs font-medium">Switch</button>
</form>
{{end}}
</div>
{{end}}
</nav>
</header>
<main class="mx-auto max-w-3xl p-4">
{{with .Nav}}{{with .Warning}}<p class="mb-4 rounded border border-amber-300 bg-amber-50 px-3 py-2 text-sm text-amber-800">{{.}}</p>{{end}}{{end}}
{{template "content" .}}
</main>
</body>
</html>
{{- end}}
