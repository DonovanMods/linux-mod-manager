{{define "content" -}}
<h1 class="mb-1 text-2xl font-bold">{{.KindTitle}}</h1>
{{with .View.Heading}}<p class="mb-4 text-sm text-gray-600">{{.}}</p>{{end}}

{{with .Notice}}
<p role="status" class="mb-4 rounded border border-amber-300 bg-amber-50 px-3 py-2 text-sm text-amber-800">{{.}}</p>
{{end}}

{{if .View.Facts}}
<section aria-label="Plan" class="mb-6">
<dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
{{range .View.Facts}}<dt class="font-medium text-gray-500">{{.Label}}</dt><dd>{{.Value}}</dd>{{end}}
</dl>
</section>
{{end}}

{{range .View.Lists}}
<section aria-label="{{.Label}}" class="mb-6">
<h2 class="mb-2 text-lg font-semibold">{{.Label}}</h2>
<!-- Rendered unbounded for v2.1.0 - no pagination. -->
<ul class="list-inside list-disc text-sm text-gray-700">
{{range .Items}}<li>{{.}}</li>{{end}}
</ul>
</section>
{{end}}

{{if .Conflicts}}
<section aria-label="File conflicts" class="mb-6">
<h2 class="mb-2 text-lg font-semibold">File conflicts</h2>
<div class="overflow-x-auto">
<table class="w-full text-left text-sm">
<caption class="sr-only">Files another installed mod already owns</caption>
<thead>
<tr class="border-b border-gray-200 text-gray-500">
<th scope="col" class="py-2 pr-4">File</th>
<th scope="col" class="py-2 pr-4">Currently owned by</th>
</tr>
</thead>
<tbody>
{{range .Conflicts}}
<tr class="border-b border-gray-100">
<td class="py-2 pr-4"><code>{{.RelativePath}}</code></td>
<td class="py-2 pr-4">{{.CurrentSourceID}}/{{.CurrentModID}}</td>
</tr>
{{end}}
</tbody>
</table>
</div>
</section>
{{end}}

<form method="post" action="{{.Action}}" class="rounded border border-gray-200 bg-white p-4">
<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
<input type="hidden" name="plan_id" value="{{.PlanID}}">
{{with .Nav}}
{{if .Game}}<input type="hidden" name="game" value="{{.Game.ID}}">{{end}}
{{if .Profile}}<input type="hidden" name="profile" value="{{.Profile}}">{{end}}
{{end}}
{{if .Overwrite}}<input type="hidden" name="accept_conflicts" value="1">{{end}}
{{range .View.Hidden}}<input type="hidden" name="{{.Key}}" value="{{.Value}}">{{end}}

{{if .View.Versions}}
<div class="mb-3">
<label class="mb-1 block text-sm font-medium text-gray-700" for="confirm-version">Version</label>
<select id="confirm-version" name="version" class="rounded border-gray-300 text-sm">
{{$v := .View.Version}}
{{range .View.Versions}}<option value="{{.}}"{{if eq . $v}} selected{{end}}>{{.}}</option>{{end}}
</select>
</div>
{{end}}

{{if .View.Files}}
<fieldset class="mb-3">
<legend class="mb-1 text-sm font-medium text-gray-700">Files</legend>
{{range $i, $f := .View.Files}}
<div class="flex items-center gap-2">
<input type="checkbox" id="confirm-file-{{$i}}" name="file" value="{{$f.ID}}"{{if $f.Selected}} checked{{end}}>
<label class="text-sm" for="confirm-file-{{$i}}">{{$f.Label}}</label>
</div>
{{end}}
</fieldset>
{{end}}

{{if .View.Toggles}}
<fieldset class="mb-3">
<legend class="mb-1 text-sm font-medium text-gray-700">Options</legend>
{{range $i, $t := .View.Toggles}}
<div class="flex items-start gap-2">
<input type="checkbox" id="confirm-toggle-{{$i}}" name="{{$t.Name}}" value="1"{{if $t.Checked}} checked{{end}}>
<label class="text-sm" for="confirm-toggle-{{$i}}">{{$t.Label}}{{with $t.Help}} <span class="text-gray-500">- {{.}}</span>{{end}}</label>
</div>
{{end}}
</fieldset>
{{end}}

<!-- "confirm" rides on the SUBMIT BUTTONS, not on a hidden field, so the
     third button below can submit the very same form WITHOUT it and be
     treated as a fresh plan request. A hidden field would always win the
     r.Form ordering and make that impossible with JavaScript off. -->
<div class="flex flex-wrap items-center gap-3">
<button type="submit" name="confirm" value="1" class="rounded border border-gray-300 bg-gray-900 px-3 py-1 text-sm font-medium text-white">{{if .Overwrite}}Overwrite and {{end}}{{.View.Submit}}</button>
{{if .View.HasOptions}}<button type="submit" class="rounded border border-gray-300 px-3 py-1 text-sm font-medium">Update plan</button>{{end}}
<button type="submit" name="confirm" value="1" formaction="{{.SyncAction}}" class="rounded border border-gray-300 px-3 py-1 text-sm font-medium">Run and wait</button>
<a class="text-sm underline" href="/mods">Cancel</a>
</div>
<p class="mt-2 text-xs text-gray-500">"{{.View.Submit}}" runs this in the background and shows a live progress page.{{if .View.HasOptions}} "Update plan" re-reads the options above and shows what they would do, without running anything.{{end}} "Run and wait" runs it here and returns the result when it finishes.</p>
</form>
{{- end}}
