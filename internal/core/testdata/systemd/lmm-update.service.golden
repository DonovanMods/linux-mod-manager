# Written by `lmm service install`; `lmm service uninstall` removes it.
# lmm's unattended self-update (#569). lmm-update.timer starts it once a
# day; it installs a new lmm release only while config.yaml says
#   auto_update: true
# and otherwise exits at once, so that setting turns updates off without
# touching this file.

[Unit]
Description=lmm unattended self-update
Documentation=https://donovanmods.github.io/linux-mod-manager/updates.html
Documentation=man:lmm-self-update(1)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment="XDG_CONFIG_HOME=/home/u/cfg"
ExecStart=/home/u/go/bin/lmm self-update --auto --data /home/u/data
NoNewPrivileges=yes
