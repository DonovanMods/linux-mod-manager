{
  "game_id": "lethal-company",
  "kind": "bepinex",
  "version": "5.4.2100",
  "mod_name": "Skinwalkers",
  "layout": "the package declares a dependency on the BepInEx framework",
  "setup": [
    "Install BepInEx into the game directory yourself: a native Linux build needs the BepInEx_linux_x64 archive from BepInEx's own GitHub releases, while a Proton/Wine game needs the Windows pack (winhttp.dll plus doorstop_config.ini). lmm does not choose or download it - the wrong build leaves a game that silently loads nothing. This mod asks for BepInEx 5.4.2100.",
    "Record it: `lmm game edit lethal-company --loader bepinex --loader-version <version> --loader-runtime mono|il2cpp --loader-bootstrap native|proton`.",
    "Then `lmm game show lethal-company` prints the exact Steam launch option to paste, and `lmm verify --game lethal-company` checks that the loader actually ran."
  ]
}
