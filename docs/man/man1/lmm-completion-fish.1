.TH "LMM" "1" "Jul 2026" "lmm 1.20.1" "User Commands"

.SH NAME
lmm-completion-fish - Generate the autocompletion script for fish


.SH SYNOPSIS
\fBlmm completion fish [flags]\fP


.SH DESCRIPTION
Generate the autocompletion script for the fish shell.

.PP
To load completions in your current shell session:

.EX
lmm completion fish | source
.EE

.PP
To load completions for every new session, execute once:

.EX
lmm completion fish > ~/.config/fish/completions/lmm.fish
.EE

.PP
You will need to start a new shell for this setup to take effect.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for fish

.PP
\fB--no-descriptions\fP[=false]
	disable completion descriptions


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	config directory (default: ~/.config/lmm)

.PP
\fB--data\fP=""
	data directory (default: ~/.local/share/lmm)

.PP
\fB-g\fP, \fB--game\fP=""
	game ID to operate on

.PP
\fB--json\fP[=false]
	output in JSON format (list, status, search, update, conflicts, verify, mod show, source list)

.PP
\fB--no-color\fP[=false]
	disable colored output (NO_COLOR env is also honored)

.PP
\fB--no-hooks\fP[=false]
	disable all hooks

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	verbose output


