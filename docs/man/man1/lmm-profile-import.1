.TH "LMM" "1" "Jul 2026" "lmm 1.24.1" "User Commands"

.SH NAME
lmm-profile-import - Import a profile


.SH SYNOPSIS
\fBlmm profile import <file> [flags]\fP


.SH DESCRIPTION
Import a profile from a YAML file.

.PP
Missing mods are downloaded and installed automatically, after a
confirmation prompt. Use --no-install to skip that entirely and just
save the profile, installing nothing. Use --force to overwrite an
existing profile with the same name instead of failing.

.PP
Examples:
  lmm profile import survival.yaml --game skyrim-se
  lmm profile import survival.yaml --game skyrim-se --no-install
  lmm profile import survival.yaml --game skyrim-se --force


.SH OPTIONS
\fB--force\fP[=false]
	overwrite existing profile

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for import

.PP
\fB--no-install\fP[=false]
	skip installing missing mods


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	config directory (default: ~/.config/lmm)

.PP
\fB--data\fP=""
	data directory (default: ~/.local/share/lmm)

.PP
\fB-g\fP, \fB--game\fP=""
	game ID to operate on

.PP
\fB--json\fP[=false]
	output in JSON format (list, status, search, update, conflicts, verify, mod show, source list)

.PP
\fB--no-color\fP[=false]
	disable colored output (NO_COLOR env is also honored)

.PP
\fB--no-hooks\fP[=false]
	disable all hooks

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	verbose output


