.TH "LMM" "1" "Jul 2026" "lmm 1.19.0" "User Commands"

.SH NAME
lmm-list - List installed mods


.SH SYNOPSIS
\fBlmm list [flags]\fP


.SH DESCRIPTION
List all mods installed in the specified game and profile.

.PP
Use --profiles to list profile names for the game instead of mods.

.PP
Examples:
  lmm list --game skyrim-se
  lmm list --game skyrim-se --profile survival
  lmm list --game skyrim-se --profiles


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for list

.PP
\fB-p\fP, \fB--profile\fP=""
	profile to list (default: active profile)

.PP
\fB--profiles\fP[=false]
	list profile names for the game instead of mods


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	config directory (default: ~/.config/lmm)

.PP
\fB--data\fP=""
	data directory (default: ~/.local/share/lmm)

.PP
\fB-g\fP, \fB--game\fP=""
	game ID to operate on

.PP
\fB--json\fP[=false]
	output in JSON format (list, status, search, update, conflicts, verify, mod show, source list)

.PP
\fB--no-color\fP[=false]
	disable colored output

.PP
\fB--no-hooks\fP[=false]
	disable all hooks

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	verbose output


