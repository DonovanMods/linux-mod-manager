.TH "LMM" "1" "Jul 2026" "lmm 2.0.0" "User Commands"

.SH NAME
lmm-serve - Start the local web UI


.SH SYNOPSIS
\fBlmm serve [flags]\fP


.SH DESCRIPTION
Start a local HTTP server with a browser-based UI over the same mod
database and profiles the CLI uses.

.PP
Binds to 127.0.0.1:7420 by default - local-only, no authentication in this
release. Binding a non-loopback address prints a warning: anyone who can
reach that address can drive lmm exactly as you can.

.PP
Opens the default browser automatically unless --no-open is given.

.PP
Examples:
  lmm serve
  lmm serve --addr 127.0.0.1:8080
  lmm serve --no-open


.SH OPTIONS
\fB--addr\fP="127.0.0.1:7420"
	address to listen on (host:port)

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for serve

.PP
\fB--no-open\fP[=false]
	don't open a browser automatically


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	config directory (default: $XDG_CONFIG_HOME/lmm or ~/.config/lmm)

.PP
\fB--data\fP=""
	data directory (default: $XDG_DATA_HOME/lmm or ~/.local/share/lmm)

.PP
\fB-g\fP, \fB--game\fP=""
	game ID to operate on

.PP
\fB--json\fP[=false]
	output JSON instead of text; mutating commands print their result, --dry-run prints the plan; never prompts

.PP
\fB--log-level\fP="off"
	diagnostic log level written to stderr (off, error, warn, info, debug)

.PP
\fB--no-color\fP[=false]
	disable colored output (NO_COLOR env is also honored)

.PP
\fB--no-hooks\fP[=false]
	disable all hooks

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	verbose output


