.SH NAME
lmm-profile-export - Export a profile


.SH SYNOPSIS
\fBlmm profile export <name> [flags]\fP


.SH DESCRIPTION
Export a profile to a portable YAML file.

.PP
The exported file can be shared with others or used as a backup.

.PP
Examples:
  lmm profile export survival --game skyrim-se > survival.yaml


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for export


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	config directory (default: ~/.config/lmm)

.PP
\fB--data\fP=""
	data directory (default: ~/.local/share/lmm)

.PP
\fB-g\fP, \fB--game\fP=""
	game ID to operate on

.PP
\fB--json\fP[=false]
	output in JSON format (list, status, search, update, conflicts, verify, mod show, source list)

.PP
\fB--no-color\fP[=false]
	disable colored output (NO_COLOR env is also honored)

.PP
\fB--no-hooks\fP[=false]
	disable all hooks

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	verbose output


.SH SEE ALSO
\fBlmm-profile(1)\fP


