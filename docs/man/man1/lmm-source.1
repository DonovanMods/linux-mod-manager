.TH "LMM" "1" "Jul 2026" "lmm 2.0.0" "User Commands"

.SH NAME
lmm-source - Manage mod sources


.SH SYNOPSIS
\fBlmm source [flags]\fP


.SH DESCRIPTION
List registered mod sources and validate user-defined source definitions.

.PP
Custom sources (directory scans, static manifests, or REST APIs) are
defined as YAML files in the sources/ directory under the config dir
(see the FILES section of 'lmm --help' for the config directory) - see
the Custom Sources section of the project README for the file format.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for source


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	config directory (default: $XDG_CONFIG_HOME/lmm or ~/.config/lmm)

.PP
\fB--data\fP=""
	data directory (default: $XDG_DATA_HOME/lmm or ~/.local/share/lmm)

.PP
\fB-g\fP, \fB--game\fP=""
	game ID to operate on

.PP
\fB--json\fP[=false]
	output JSON instead of text; mutating commands print their result, --dry-run prints the plan; never prompts

.PP
\fB--log-level\fP="off"
	diagnostic log level written to stderr (off, error, warn, info, debug)

.PP
\fB--no-color\fP[=false]
	disable colored output (NO_COLOR env is also honored)

.PP
\fB--no-hooks\fP[=false]
	disable all hooks

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	verbose output


