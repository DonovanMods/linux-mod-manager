.SH NAME
lmm-profile-switch - Switch to a different profile


.SH SYNOPSIS
\fBlmm profile switch <name> [flags]\fP


.SH DESCRIPTION
Switch to a different profile, deploying its mods to the game directory.

.PP
This will undeploy mods from the current profile and deploy mods from the new profile.

.PP
Examples:
  lmm profile switch survival --game skyrim-se


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for switch


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	config directory (default: ~/.config/lmm)

.PP
\fB--data\fP=""
	data directory (default: ~/.local/share/lmm)

.PP
\fB-g\fP, \fB--game\fP=""
	game ID to operate on

.PP
\fB--json\fP[=false]
	output in JSON format (list, status, search, update, conflicts, verify, mod show, source list)

.PP
\fB--no-color\fP[=false]
	disable colored output (NO_COLOR env is also honored)

.PP
\fB--no-hooks\fP[=false]
	disable all hooks

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	verbose output


