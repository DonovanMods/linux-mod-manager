.TH "LMM" "1" "Jul 2026" "lmm 1.22.0" "User Commands"

.SH NAME
lmm-mod-enable - Enable a disabled mod


.SH SYNOPSIS
\fBlmm mod enable <mod-id> [flags]\fP


.SH DESCRIPTION
Enable a mod that was previously disabled.

.PP
This deploys the mod files from the cache to the game directory.
The mod must already be installed and in the cache.

.PP
Examples:
  lmm mod enable 12345 --game skyrim-se
  lmm mod enable 12345 --game skyrim-se --profile survival


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for enable


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	config directory (default: ~/.config/lmm)

.PP
\fB--data\fP=""
	data directory (default: ~/.local/share/lmm)

.PP
\fB-g\fP, \fB--game\fP=""
	game ID to operate on

.PP
\fB--json\fP[=false]
	output in JSON format (list, status, search, update, conflicts, verify, mod show, source list)

.PP
\fB--no-color\fP[=false]
	disable colored output (NO_COLOR env is also honored)

.PP
\fB--no-hooks\fP[=false]
	disable all hooks

.PP
\fB-p\fP, \fB--profile\fP=""
	profile (default: active profile)

.PP
\fB-s\fP, \fB--source\fP=""
	mod source (default: the sole configured source; prompts when several are configured)

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	verbose output


