.TH "LMM" "1" "Jul 2026" "lmm 1.20.0" "User Commands"

.SH NAME
lmm-mod-disable - Disable a mod without uninstalling


.SH SYNOPSIS
\fBlmm mod disable  [flags]\fP


.SH DESCRIPTION
Disable a mod by removing its files from the game directory.

.PP
The mod remains installed and cached, so it can be re-enabled later
without downloading again.

.PP
Examples:
  lmm mod disable 12345 --game skyrim-se
  lmm mod disable 12345 --game skyrim-se --profile survival


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for disable


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	config directory (default: ~/.config/lmm)

.PP
\fB--data\fP=""
	data directory (default: ~/.local/share/lmm)

.PP
\fB-g\fP, \fB--game\fP=""
	game ID to operate on

.PP
\fB--json\fP[=false]
	output in JSON format (list, status, search, update, conflicts, verify, mod show, source list)

.PP
\fB--no-color\fP[=false]
	disable colored output

.PP
\fB--no-hooks\fP[=false]
	disable all hooks

.PP
\fB-p\fP, \fB--profile\fP=""
	profile (default: active profile)

.PP
\fB-s\fP, \fB--source\fP=""
