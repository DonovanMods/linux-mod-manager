.TH "LMM" "1" "Nov 2026" "lmm 2.3.0" "User Commands"

.SH NAME
lmm-plugins-rules-remove - Remove a plugin's rule, or part of it


.SH SYNOPSIS
\fBlmm plugins rules remove <plugin> [--after <plugin>]... [--req <plugin>]... [--clear-group] [flags]\fP


.SH DESCRIPTION
Remove a plugin's whole rule, or with --after, --req or --clear-group
only those parts of it. A rule left with nothing in it is removed.


.SH OPTIONS
\fB--after\fP=[]
	a plugin it loads after (repeatable)

.PP
\fB--clear-group\fP[=false]
	take it out of its group

.PP
\fB--dry-run\fP[=false]
	print what would change without changing anything

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for remove

.PP
\fB--req\fP=[]
	a plugin it requires (repeatable)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	config directory (default: $XDG_CONFIG_HOME/lmm or ~/.config/lmm)

.PP
\fB--data\fP=""
	data directory (default: $XDG_DATA_HOME/lmm or ~/.local/share/lmm)

.PP
\fB-g\fP, \fB--game\fP=""
	game ID to operate on

.PP
\fB--json\fP[=false]
	output JSON instead of text; mutating commands print their result, --dry-run prints the plan; never prompts

.PP
\fB--log-level\fP="off"
	diagnostic log level written to stderr (off, error, warn, info, debug)

.PP
\fB--no-color\fP[=false]
	disable colored output (NO_COLOR env is also honored)

.PP
\fB--no-hooks\fP[=false]
	disable all hooks

.PP
\fB-p\fP, \fB--profile\fP=""
	profile (default: active profile)

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	verbose output


.SH EXAMPLE
.EX
  lmm plugins rules remove Patch.esp
  lmm plugins rules remove Patch.esp --after SkyUI\\_SE.esp
.EE


.SH SEE ALSO
\fBlmm-plugins-rules(1)\fP


