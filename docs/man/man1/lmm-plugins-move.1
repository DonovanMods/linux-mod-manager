.TH "LMM" "1" "Nov 2026" "lmm 2.3.0" "User Commands"

.SH NAME
lmm-plugins-move - Move a plugin in the load order


.SH SYNOPSIS
\fBlmm plugins move <plugin> (--before <plugin> | --after <plugin> | --first | --last) [flags]\fP


.SH DESCRIPTION
Move a plugin lmm deploys before or after another one, or to the top or
the end of the order. The profile records the whole order as you see it in
\&'lmm plugins list', so nothing else moves.

.PP
A rule or a master can hold a plugin where it is: a plugin always loads
after its masters, and after the plugins your rules put before it. The
move is still recorded, and --dry-run says what holds the plugin.


.SH OPTIONS
\fB--after\fP=""
	move it just after this plugin

.PP
\fB--before\fP=""
	move it just before this plugin

.PP
\fB--dry-run\fP[=false]
	print what would change without changing anything

.PP
\fB--first\fP[=false]
	move it to the top of the order

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for move

.PP
\fB--last\fP[=false]
	move it to the end of the order


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	config directory (default: $XDG_CONFIG_HOME/lmm or ~/.config/lmm)

.PP
\fB--data\fP=""
	data directory (default: $XDG_DATA_HOME/lmm or ~/.local/share/lmm)

.PP
\fB-g\fP, \fB--game\fP=""
	game ID to operate on

.PP
\fB--json\fP[=false]
	output JSON instead of text; mutating commands print their result, --dry-run prints the plan; never prompts

.PP
\fB--log-level\fP="off"
	diagnostic log level written to stderr (off, error, warn, info, debug)

.PP
\fB--no-color\fP[=false]
	disable colored output (NO_COLOR env is also honored)

.PP
\fB--no-hooks\fP[=false]
	disable all hooks

.PP
\fB-p\fP, \fB--profile\fP=""
	profile (default: active profile)

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	verbose output


.SH EXAMPLE
.EX
  lmm plugins move Patch.esp --after SkyUI\\_SE.esp
  lmm plugins move "Optional Thing.esp" --last --dry-run
.EE


