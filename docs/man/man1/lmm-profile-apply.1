.TH "LMM" "1" "Jul 2026" "lmm 1.20.0" "User Commands"

.SH NAME
lmm-profile-apply - Apply profile to system


.SH SYNOPSIS
\fBlmm profile apply [name] [flags]\fP


.SH DESCRIPTION
Make the system match the profile by installing/enabling/disabling mods.

.PP
Use this after manually editing a profile YAML to apply those changes.
If no name is given, uses the current/default profile. Prompts for
confirmation before making any changes; pass -y/--yes to skip the prompt.

.PP
Examples:
  lmm profile apply --game skyrim-se
  lmm profile apply survival --game skyrim-se
  lmm profile apply survival --game skyrim-se --yes


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for apply

.PP
\fB-y\fP, \fB--yes\fP[=false]
	auto-confirm changes


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	config directory (default: ~/.config/lmm)

.PP
\fB--data\fP=""
	data directory (default: ~/.local/share/lmm)

.PP
\fB-g\fP, \fB--game\fP=""
	game ID to operate on

.PP
\fB--json\fP[=false]
	output in JSON format (list, status, search, update, conflicts, verify, mod show, source list)

.PP
\fB--no-color\fP[=false]
	disable colored output (NO_COLOR env is also honored)

.PP
\fB--no-hooks\fP[=false]
	disable all hooks

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	verbose output


