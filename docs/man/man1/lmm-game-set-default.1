.SH NAME
lmm-game-set-default - Set the default game


.SH SYNOPSIS
\fBlmm game set-default <game-id> [flags]\fP


.SH DESCRIPTION
Set the default game so you don't have to specify --game for every command.

.PP
Examples:
  lmm game set-default skyrim-se
  lmm game set-default starrupture


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for set-default


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	config directory (default: ~/.config/lmm)

.PP
\fB--data\fP=""
	data directory (default: ~/.local/share/lmm)

.PP
\fB-g\fP, \fB--game\fP=""
	game ID to operate on

.PP
\fB--json\fP[=false]
	output in JSON format (list, status, search, update, conflicts, verify, mod show, source list)

.PP
\fB--no-color\fP[=false]
	disable colored output (NO_COLOR env is also honored)

.PP
\fB--no-hooks\fP[=false]
	disable all hooks

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	verbose output


