.TH "LMM" "1" "Jul 2026" "lmm 1.30.1" "User Commands"

.SH NAME
lmm-mod-set-update - Set update policy for a mod


.SH SYNOPSIS
\fBlmm mod set-update <mod-id> [flags]\fP


.SH DESCRIPTION
Set the update policy for an installed mod.

.PP
Policies:
  --auto    Automatically apply updates when checking
  --notify  Show available updates, require manual approval (default)
  --pin     Mute update checks for this mod (to hold an exact version, use 'lmm mod lock')

.PP
Examples:
  lmm mod set-update 12345 --game skyrim-se --auto
  lmm mod set-update 12345 --game skyrim-se --pin
  lmm mod set-update 12345 --game skyrim-se --notify


.SH OPTIONS
\fB--auto\fP[=false]
	enable auto-update

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for set-update

.PP
\fB--notify\fP[=false]
	notify only (default)

.PP
\fB--pin\fP[=false]
	mute update checks for this mod (to hold an exact version, use 'lmm mod lock')


