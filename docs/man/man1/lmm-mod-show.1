.TH "LMM" "1" "Jul 2026" "lmm 1.30.1" "User Commands"

.SH NAME
lmm-mod-show - Show mod details


.SH SYNOPSIS
\fBlmm mod show <mod-id> [flags]\fP


.SH DESCRIPTION
Fetch and display mod details from the source (description, summary, image URL).

.PP
Does not require the mod to be installed. Use --json for scriptable output.

.PP
Examples:
  lmm mod show 12345 --game skyrim-se
  lmm mod show 12345 --game skyrim-se --json


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for show


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	config directory (default: $XDG_CONFIG_HOME/lmm or ~/.config/lmm)

.PP
\fB--data\fP=""
	data directory (default: $XDG_DATA_HOME/lmm or ~/.local/share/lmm)

.PP
\fB-g\fP, \fB--game\fP=""
	game ID to operate on

.PP
\fB--json\fP[=false]
	output in JSON format (list, status, search, update, conflicts, verify, mod show, source list, game list)

.PP
\fB--no-color\fP[=false]
	disable colored output (NO_COLOR env is also honored)

.PP
\fB--no-hooks\fP[=false]
	disable all hooks

.PP
\fB-p\fP, \fB--profile\fP=""
	profile (default: active profile)

.PP
\fB-s\fP, \fB--source\fP=""
	mod source (default: the sole configured source; prompts when several are configured)

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	verbose output


.SH SEE ALSO
\fBlmm-mod(1)\fP


